{
  "name": "@qa-lab/banking-app",
  "version": "1.0.0",
  "private": true,
  "description": "Digital banking demo API and UI used as the system under test.",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test:api": "npm --prefix .. run test:api",
    "test:e2e": "npm --prefix .. run test:e2e",
    "test:db": "npm --prefix .. run test:db",
    "test": "npm --prefix .. test",
    "report": "npm --prefix .. run report"
  },
  "dependencies": {
    "express": "5.3.0",
    "pg-mem": "3.0.14"
  }
}
