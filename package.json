{
  "name": "qa-automation-2026",
  "version": "1.0.0",
  "private": true,
  "description": "Digital banking QA automation lab: Playwright API/E2E, SQL integrity, contract and k6 performance testing.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "app"
  ],
  "scripts": {
    "start": "node app/server.js",
    "dev": "node --watch app/server.js",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test --project=e2e",
    "test:db": "node --test tests/db/integrity.test.js",
    "test": "npm run test:db && npm run test:api && npm run test:e2e",
    "report": "playwright show-report",
    "validate:db": "node scripts/validate-db.js"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "ajv": "8.20.0",
    "yaml": "2.9.1"
  }
}
